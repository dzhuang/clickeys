{
    "name": "clickeys",
    "version": "1.0.0",
    "description": "Typing sound effect application for Windows and macOS",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:mac": "electron-builder --mac",
        "pack": "electron-builder --dir"
    },
    "author": "Clickeys",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "electron-store": "^8.0.2",
        "keyspy": "^1.0.0"
    },
    "build": {
        "npmRebuild": false,
        "appId": "com.clickeys.app",
        "productName": "Clickeys",
        "publish": null,
        "asar": true,
        "asarUnpack": [
            "node_modules/keyspy/runtime/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icon.png",
            "category": "public.app-category.music",
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true
        },
        "dmg": {
            "title": "Clickeys",
            "contents": [
                { "x": 130, "y": 220, "type": "file" },
                { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
            ]
        },
        "files": [
            "main.js",
            "preload.js",
            "src/**/*",
            "data/**/*",
            "assets/**/*"
        ],
        "extraResources": [
            {
                "from": "data",
                "to": "data"
            }
        ]
    }
}
